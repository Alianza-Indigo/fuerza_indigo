# =============================================================================
# Plataforma Integral Fuerza Índigo — plantilla de variables de entorno
# =============================================================================
# Este archivo NO contiene secretos. Copie a `.env.local` para desarrollo y
# configure los valores reales en el panel de Vercel para vista previa y
# producción. El propósito, obligatoriedad, formato y ambiente de cada variable
# está documentado en `docs/ENVIRONMENT.md` (PRD §21).
#
# Regla: ninguna variable con prefijo NEXT_PUBLIC_ puede contener un secreto.
# La ausencia de una variable obligatoria detiene el arranque con un error
# comprensible que nunca revela el valor esperado.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicación y sesiones
# -----------------------------------------------------------------------------
# URL absoluta y canónica de la instancia, sin barra final. Ej.: https://fuerzaindigo.lat
APP_URL=
# Secreto de firma de sesiones y tokens internos. 32 bytes aleatorios en base64url.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# -----------------------------------------------------------------------------
# Superadmin por variables de entorno (PRD §4.4)
# -----------------------------------------------------------------------------
# Correo del Superadmin raíz. No existe como registro editable en la base.
SUPERADMIN_EMAIL=
# Hash Argon2id de la contraseña. Generar con: npm run auth:hash-password
# Formato esperado: $argon2id$v=19$m=...,t=...,p=...$...
SUPERADMIN_PASSWORD_HASH=
# Entero incremental. Aumentarlo invalida de inmediato todas las sesiones de Superadmin.
SUPERADMIN_SESSION_VERSION=1

# -----------------------------------------------------------------------------
# Base de datos Neon PostgreSQL (PRD §17.1, §17.3)
# -----------------------------------------------------------------------------
# Conexión agrupada (pooler) usada por la aplicación en tiempo de ejecución serverless.
DATABASE_URL=
# Conexión directa usada exclusivamente por las migraciones de Prisma.
DIRECT_URL=

# -----------------------------------------------------------------------------
# Almacenamiento de objetos: Vercel Blob (PRD §17.4)
# -----------------------------------------------------------------------------
# Token de lectura y escritura del almacén Blob. Los archivos son privados por omisión.
BLOB_READ_WRITE_TOKEN=
# Secreto para firmar las URL temporales de descarga emitidas por la aplicación.
FILE_URL_SIGNING_SECRET=

# -----------------------------------------------------------------------------
# Stripe — cuenta de Fuerza Índigo (conceptos sindicales) (PRD §11.2)
# -----------------------------------------------------------------------------
STRIPE_FUERZA_SECRET_KEY=
STRIPE_FUERZA_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_FUERZA_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Stripe — cuenta de Alianza Índigo A.C. (programas sociales, CIAN, CENI)
# -----------------------------------------------------------------------------
STRIPE_ALIANZA_SECRET_KEY=
STRIPE_ALIANZA_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_ALIANZA_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Inteligencia artificial: Gemini (PRD §15)
# -----------------------------------------------------------------------------
# Clave del SDK oficial de Google. Se usa exclusivamente en servidor.
GEMINI_API_KEY=
# Identificador del modelo por omisión. Ej.: gemini-2.5-flash
GEMINI_DEFAULT_MODEL=

# -----------------------------------------------------------------------------
# Correo transaccional (PRD §16.2)
# -----------------------------------------------------------------------------
# Adaptador activo: resend | smtp | console
EMAIL_PROVIDER=console
# Remitente verificado. Ej.: Fuerza Indigo <no-responder@fuerzaindigo.lat>
EMAIL_FROM=
# Clave del proveedor de correo. Vacía cuando EMAIL_PROVIDER=console.
EMAIL_API_KEY=

# -----------------------------------------------------------------------------
# Trabajos programados y verificación pública
# -----------------------------------------------------------------------------
# Secreto compartido que autentica las invocaciones de Vercel Cron a /api/v1/cron/*.
CRON_SECRET=
# Llavero de firma de los códigos QR de credenciales y distintivos CENI.
# Formato: lista de entradas "identificador:clave" separadas por comas; la primera es
# la activa. Las anteriores permanecen para verificar lo ya emitido durante una
# rotación. Ej.: k2:<32 bytes base64url>,k1:<32 bytes base64url>
QR_SIGNING_SECRET=
